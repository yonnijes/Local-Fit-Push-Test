# --- Servidor ---------------------------------------------------------------
PORT=3000

# Origen público de la PWA (URL HTTPS de Cloudflare Tunnel).
# Si se deja vacío no se valida el header Origin; el token sigue siendo
# obligatorio para los endpoints de administración.
PUBLIC_APP_URL=

# --- VAPID (generar con: pnpm vapid:keys) -----------------------------------
VAPID_SUBJECT=mailto:dev@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Seguridad --------------------------------------------------------------
# Token exigido en POST /api/push/send-test, /start y /stop.
# Si se deja vacío, el backend genera uno aleatorio al arrancar y lo muestra
# una sola vez en la consola. Nunca se incluye en el bundle de React.
PUSH_TEST_ADMIN_TOKEN=

# --- Opcional ---------------------------------------------------------------
# Ruta al build del frontend si se mueve de sitio.
# WEB_DIST_PATH=../web/dist
